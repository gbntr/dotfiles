[urgency_low]
    background = "#1b1b25cc"
    foreground = "#dedede"
    timeout = 5
[urgency_normal]
    background = "#1b1b25cc"
    foreground = "#dedede"
    timeout = 5
[urgency_critical]
    background = "#1b1b25cc"
    foreground = "#dedede"
    frame_color = "#cb5760"
    timeout = 0
[global]
    width = 300
    height = 200
    origin = top-right
    offset = (10, 35)
    frame_width = 1
    frame_color = "#6c90a8"
    corner_radius = 12
    font = Roboto mono 10
    padding = 10
    horizontal_padding = 10
    separator_height = 2
    separator_color = frame
    format = "<b>%s</b>\n%b"
[experimental]
    per_monitor_dpi = false
